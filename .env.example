# Telegram push for contact-form submissions.
# 1. Message @BotFather -> /newbot -> copy the token.
# 2. Add the bot to a private channel/group (or DM it), send one message.
# 3. curl "https://api.telegram.org/bot<TOKEN>/getUpdates" and copy chat.id
#    (channel ids look like -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# HMAC key signing the `lab_access` cookie, which remembers a reader's
# From the Lab registration for 180 days. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave blank locally: `astro dev` self-provisions one in .local/.
# Required in Preview and Production — unset there, the cookie is never set and
# registered readers are re-prompted forever, with no error logged. Rotating it
# invalidates every existing cookie; signups still reach Telegram either way.
LAB_ACCESS_SECRET=
