---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---

<Layout
  title="Contact | 17th Street Labs"
  description="Send 17th Street Labs the AI problem nobody knows how to solve: the agent that works 90% of the time, the eval nobody trusts, the workflow that costs a fortune."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="chip">Contact</p>
      <h1 class="statement">Start a project.</h1>
      <p class="lede">
        The agent that works 90% of the time. The eval nobody trusts. The
        workflow that costs a fortune. The product that needs more than another
        chat window. The sensitive data you do not want anywhere near a
        third-party model. That is the work we want. Nothing here goes to a
        queue. It goes to the engineers who would do the work.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="wrap contact">
      <div class="contact-aside">
        <dl>
          <div>
            <dt>Who replies</dt>
            <dd>An engineer who builds this stuff, not a sales desk. Within a business day.</dd>
          </div>
          <div>
            <dt>Where</dt>
            <dd>Denver, New York City, and Boston. We work with teams in any time zone.</dd>
          </div>
        </dl>
      </div>
      <div class="panel contact-panel">
        <h2>Three sentences is plenty.</h2>
        <form
          data-project-brief
          action="/api/contact/"
          method="post"
        >
          <label class="honeypot" aria-hidden="true">
            Company
            <input name="company" tabindex="-1" autocomplete="off" />
          </label>
          <div class="form-row">
            <label>
              Name
              <input name="name" autocomplete="name" required />
            </label>
            <label>
              Work email
              <input name="email" autocomplete="email" required type="email" />
            </label>
          </div>
          <label>
            What are you building?
            <textarea
              name="context"
              required
              rows={7}
              placeholder="What the system does, where it fails, and what that failure costs."
            ></textarea>
          </label>
          <button class="button button-solid" type="submit">
            Send project brief
            <Icon name="ArrowRight" size={16} />
          </button>
          <p class="form-status" data-form-status role="status" aria-live="polite"></p>
          <small>Goes straight to the team. Reply within a business day.</small>
        </form>
      </div>
    </div>
  </section>
</Layout>
