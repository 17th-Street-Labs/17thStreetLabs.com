---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact | 17th Street Labs"
  description="Start a conversation with 17th Street Labs about your AI engineering, security, or evaluation challenge."
>
  <section class="page-hero ground-black">
    <div class="wrap">
      <p class="kicker">Contact</p>
      <h1 class="statement">Bring the hard problem.</h1>
      <p class="lede">
        Tell us what you are building, where confidence breaks down, and what a
        meaningful result would change. Nothing here goes to a queue. It goes
        to Dan.
      </p>
    </div>
  </section>

  <section class="band ground-white">
    <div class="wrap contact">
      <div class="contact-aside">
        <dl>
          <div>
            <dt>Email</dt>
            <dd><a href="mailto:dan@danlevy.net">dan@danlevy.net</a></dd>
          </div>
          <div>
            <dt>Who replies</dt>
            <dd>Dan Levy, principal AI engineer, and Marina Levy, chief executive. Within a business day.</dd>
          </div>
          <div>
            <dt>Where</dt>
            <dd>Denver, Colorado. We work with teams in any time zone.</dd>
          </div>
        </dl>
      </div>
      <div class="contact-panel">
        <h2>Three useful sentences are enough.</h2>
        <form
          data-project-brief
          action="mailto:dan@danlevy.net?subject=17th%20Street%20Labs%20%E2%80%94%20project%20brief"
          method="post"
          enctype="text/plain"
        >
          <div class="form-row">
            <label>
              Name
              <input name="name" autocomplete="name" required />
            </label>
            <label>
              Work email
              <input name="email" autocomplete="email" required type="email" />
            </label>
          </div>
          <label>
            What is at stake?
            <textarea
              name="context"
              required
              rows={7}
              placeholder="The system, the uncertainty, and the consequence."
            ></textarea>
          </label>
          <button class="button button-solid" type="submit">
            Open project brief
          </button>
          <small>Opens your email app with a draft you can edit before sending.</small>
        </form>
      </div>
    </div>
  </section>
</Layout>
