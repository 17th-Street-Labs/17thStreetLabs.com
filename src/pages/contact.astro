---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---

<Layout
  title="Contact | 17th Street Labs"
  description="Start a conversation with 17th Street Labs about your AI engineering, security, or evaluation challenge."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="chip">Contact</p>
      <h1 class="statement">Bring the hard problem.</h1>
      <p class="lede">
        Tell us what you are building, where confidence breaks down, and what a
        meaningful result would change. Nothing here goes to a queue. It goes
        to the engineers who would do the work.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="wrap contact">
      <div class="contact-aside">
        <dl>
          <div>
            <dt>Who replies</dt>
            <dd>A senior engineer on the team, not a sales desk. Within a business day.</dd>
          </div>
          <div>
            <dt>Where</dt>
            <dd>Denver, Colorado. We work with teams in any time zone.</dd>
          </div>
        </dl>
      </div>
      <div class="panel contact-panel">
        <h2>Three useful sentences are enough.</h2>
        <form
          data-project-brief
          action="/api/contact/"
          method="post"
        >
          <label class="honeypot" aria-hidden="true">
            Company
            <input name="company" tabindex="-1" autocomplete="off" />
          </label>
          <div class="form-row">
            <label>
              Name
              <input name="name" autocomplete="name" required />
            </label>
            <label>
              Work email
              <input name="email" autocomplete="email" required type="email" />
            </label>
          </div>
          <label>
            What is at stake?
            <textarea
              name="context"
              required
              rows={7}
              placeholder="The system, the uncertainty, and the consequence."
            ></textarea>
          </label>
          <button class="button button-solid" type="submit">
            Send project brief
            <Icon name="ArrowRight" size={16} />
          </button>
          <p class="form-status" data-form-status role="status" aria-live="polite"></p>
          <small>Goes straight to the team. Reply within a business day.</small>
        </form>
      </div>
    </div>
  </section>
</Layout>
