---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found | 17th Street Labs"
  description="Find your way back to 17th Street Labs."
  noindex
>
  <section class="page-hero">
    <div class="wrap">
      <p class="chip">Error 404</p>
      <h1 class="statement">This page is off the map.</h1>
      <p class="lede">The agent completed the task. Allegedly. This URL is in the 10%. Head back home or look at what we do.</p>
      <div class="hero-actions">
        <a class="button button-solid" href="/">Back to home</a>
        <a class="button button-line" href="/services/"><span>See services</span></a>
      </div>
    </div>
  </section>
</Layout>
