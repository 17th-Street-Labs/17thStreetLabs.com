---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found | 17th Street Labs"
  description="Find your way back to 17th Street Labs."
  noindex
>
  <section class="page-hero">
    <div class="container">
      <p class="lede">Error 404</p>
      <h1>This page is off the map.</h1>
      <p class="lede">
        The address may have changed. Head back home or look at what we do.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/">Back to home</a>
        <a class="button button-ghost" href="/services/">See services</a>
      </div>
    </div>
  </section>
</Layout>
