---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { services } from "../data/services";
const icons: Record<string, string> = {
  evals: "Gauge",
  agents: "Braces",
  products: "Sparkles",
  models: "Compass",
  security: "ShieldCheck",
};
---

<Layout
  title="Services | 17th Street Labs"
  description="AI Evals & Reliability, Agentic Systems, AI-Native Products, Model Strategy, and AI Security. We build the engineering around the intelligence."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="chip">Services</p>
      <h1 class="statement">We build the engineering around the intelligence.</h1>
      <p class="lede">The agent. The eval. The token bill. Let’s figure it out.</p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="detail">
        {services.map((service) => (
          <article id={service.slug} class="card">
            <div>
              <span class="card-icon"><Icon name={icons[service.slug]} /></span>
              <h2>{service.title}</h2>
              <span class="outcome">{service.outcome}</span>
            </div>
            <div class="detail-body">
              {service.paragraphs.map((paragraph) => (<p set:html={paragraph} />))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head">
        <p class="chip">Process</p>
        <h2 class="section-title">How we work</h2>
        <p>Find the failure. Fix it. Prove it.</p>
      </div>
      <div class="accordion">
        <details name="engagement" data-slot="accordion-item" open>
          <summary data-slot="accordion-trigger">
            <span class="idx">01</span>
            <span>Name the failure that matters</span>
            <span class="plus" aria-hidden="true"></span>
          </summary>
          <div data-slot="accordion-content">
            We find out what the 10% actually looks like: the decision, failure
            mode, or capability at stake, and what “working” means in numbers
            rather than vibes. Usually a one to two week, fixed-fee piece of
            work with a baseline measurement and a written recommendation.
          </div>
        </details>
        <details name="engagement" data-slot="accordion-item">
          <summary data-slot="accordion-trigger">
            <span class="idx">02</span>
            <span>Change something. Measure it again.</span>
            <span class="plus" aria-hidden="true"></span>
          </summary>
          <div data-slot="accordion-content">
            Architecture, research, and evals move together. Every change is
            compared to baseline so you know what improved, what broke, and
            why, early enough to change direction while it is still cheap.
          </div>
        </details>
        <details name="engagement" data-slot="accordion-item">
          <summary data-slot="accordion-trigger">
            <span class="idx">03</span>
            <span>Prove it holds, then hand it over</span>
            <span class="plus" aria-hidden="true"></span>
          </summary>
          <div data-slot="accordion-content">
            We pressure-test the system, turn findings into controls and
            regression gates you can run in CI, and transfer the operating
            capability to your team. You should not need us for the next
            change. You should be able to measure it yourself.
          </div>
        </details>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="closing">
        <h2 class="statement">Got an AI problem that's getting weird?</h2>
        <p>Good. Those are usually the interesting ones.</p>
        <div class="hero-actions">
          <a class="button button-solid" href="/contact/">
            Let's talk
            <Icon name="ArrowRight" size={16} />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
