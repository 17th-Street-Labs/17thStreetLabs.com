---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { services } from "../data/services";
const icons: Record<string, string> = {
  engineering: "Braces",
  security: "ShieldCheck",
  evals: "Gauge",
  advisory: "Compass",
};
---

<Layout
  title="Services | 17th Street Labs"
  description="AI product engineering, AI security, evaluations and reliability, and hands-on technical advisory from senior practitioners."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="chip">Services</p>
      <h1 class="statement">Senior hands on the hard part.</h1>
      <p class="lede">
        We enter where capability, uncertainty, and consequence meet. Every
        engagement is led hands-on by the founders, not handed to a bench.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="detail">
        {services.map((service) => (
          <article id={service.slug} class="card">
            <div>
              <span class="card-icon"><Icon name={icons[service.slug]} /></span>
              <h2>{service.title}</h2>
              <span class="outcome">{service.outcome}</span>
            </div>
            <div class="detail-body">
              <p>{service.summary}</p>
              <h3>A good fit when</h3>
              <ul class="marks">
                {service.fits.map((fit) => (
                  <li>{fit}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head">
        <p class="chip">Process</p>
        <h2 class="section-title">How we work</h2>
        <p>Clarity before ceremony. Open a step to see what it means in practice.</p>
      </div>
      <div class="accordion">
        <details name="engagement" data-slot="accordion-item" open>
          <summary data-slot="accordion-trigger">
            <span class="idx">01</span>
            <span>Frame the question that matters</span>
            <span class="plus" aria-hidden="true"></span>
          </summary>
          <div data-slot="accordion-content">
            We identify the decision, failure mode, or capability at stake and
            write down success criteria before implementation expands. Usually
            a one to two week, fixed-fee piece of work with a written
            recommendation at the end.
          </div>
        </details>
        <details name="engagement" data-slot="accordion-item">
          <summary data-slot="accordion-trigger">
            <span class="idx">02</span>
            <span>Build the smallest credible proof</span>
            <span class="plus" aria-hidden="true"></span>
          </summary>
          <div data-slot="accordion-content">
            Architecture, research, and evaluation proceed together. You get
            working software and measured results early enough to change
            direction while it is still cheap to do so.
          </div>
        </details>
        <details name="engagement" data-slot="accordion-item">
          <summary data-slot="accordion-trigger">
            <span class="idx">03</span>
            <span>Harden what survives, then hand it over</span>
            <span class="plus" aria-hidden="true"></span>
          </summary>
          <div data-slot="accordion-content">
            We pressure-test the system, turn findings into controls and
            regression gates, and transfer the operating capability to your
            team. The goal is that you do not need us for the next change.
          </div>
        </details>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="closing">
        <h2 class="statement">Not sure which one you need?</h2>
        <p>Describe the problem. We will tell you honestly whether we are the right fit.</p>
        <div class="hero-actions">
          <a class="button button-solid" href="/contact/">
            Tell us what is stuck
            <Icon name="ArrowRight" size={16} />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
