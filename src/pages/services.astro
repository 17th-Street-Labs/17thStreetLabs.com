---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { services } from "../data/services";
const icons: Record<string, string> = {
  evals: "Gauge",
  agents: "Braces",
  products: "Sparkles",
  security: "ShieldCheck",
};
---

<Layout
  title="Services | 17th Street Labs"
  description="Evals and reliability, agentic systems, AI-native products and model strategy, and AI security. The engineering layer around modern AI, from people who build it, break it, and measure it."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="chip">Services</p>
      <h1 class="statement">The interesting part starts after the demo.</h1>
      <p class="lede">
        You already know how to call an LLM. The hard part is everything
        around the call: evaluation, architecture, context, tools, memory,
        retries, parallelism, observability, regressions, costs, and failure
        handling. That is the work, and the people you meet are the people who
        do it.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="detail">
        {services.map((service) => (
          <article id={service.slug} class="card">
            <div>
              <span class="card-icon"><Icon name={icons[service.slug]} /></span>
              <h2>{service.title}</h2>
              <span class="outcome">{service.outcome}</span>
            </div>
            <div class="detail-body">
              <p>{service.summary}</p>
              <h3>A good fit when</h3>
              <ul class="marks">
                {service.fits.map((fit) => (
                  <li>{fit}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head">
        <p class="chip">Process</p>
        <h2 class="section-title">How we work</h2>
        <p>Measure it. Test it. Break it. Compare it to baseline. Prove the fix worked. Open a step to see what that means in practice.</p>
      </div>
      <div class="accordion">
        <details name="engagement" data-slot="accordion-item" open>
          <summary data-slot="accordion-trigger">
            <span class="idx">01</span>
            <span>Name the failure that matters</span>
            <span class="plus" aria-hidden="true"></span>
          </summary>
          <div data-slot="accordion-content">
            We find out what the 10% actually looks like: the decision, failure
            mode, or capability at stake, and what “working” means in numbers
            rather than vibes. Usually a one to two week, fixed-fee piece of
            work with a baseline measurement and a written recommendation.
          </div>
        </details>
        <details name="engagement" data-slot="accordion-item">
          <summary data-slot="accordion-trigger">
            <span class="idx">02</span>
            <span>Change something. Measure it again.</span>
            <span class="plus" aria-hidden="true"></span>
          </summary>
          <div data-slot="accordion-content">
            Architecture, research, and evals move together. Every change is
            compared to baseline so you know what improved, what broke, and
            why, early enough to change direction while it is still cheap.
          </div>
        </details>
        <details name="engagement" data-slot="accordion-item">
          <summary data-slot="accordion-trigger">
            <span class="idx">03</span>
            <span>Prove it holds, then hand it over</span>
            <span class="plus" aria-hidden="true"></span>
          </summary>
          <div data-slot="accordion-content">
            We pressure-test the system, turn findings into controls and
            regression gates you can run in CI, and transfer the operating
            capability to your team. You should not need us for the next
            change. You should be able to measure it yourself.
          </div>
        </details>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="closing">
        <h2 class="statement">Got a weird AI problem?</h2>
        <p>Describe it. We will tell you honestly whether we are the right people to make it work.</p>
        <div class="hero-actions">
          <a class="button button-solid" href="/contact/">
            Show us what is breaking
            <Icon name="ArrowRight" size={16} />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
