---
import danHeadshot from "../images/headshots/dan-avatar.png";
import marinaHeadshot from "../images/headshots/Marina-Levy-Headshot.png";
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import HeroThreads from "../components/HeroThreads.astro";
import { services, proof, findings } from "../data/services";
const icons: Record<string, string> = {
  engineering: "Braces",
  security: "ShieldCheck",
  evals: "Gauge",
  advisory: "Compass",
};
const log = [
  { t: "00:00", tag: "run", cls: "tag-blue", text: "checkout-agent · 214 scenarios · 3 judges · seed 418" },
  { t: "00:04", tag: "probe", cls: "tag-blue", text: "prompt injection via vendor invoice PDF (tool output)" },
  { t: "00:09", tag: "found", cls: "tag-red", text: "agent issued refund 40× over task ceiling · no spend gate" },
  { t: "00:11", tag: "found", cls: "tag-red", text: "OAuth token scoped to org:* · task needed orders:read" },
  { t: "00:16", tag: "probe", cls: "tag-blue", text: "cross-tenant retrieval · 1,200 synthetic tenants" },
  { t: "00:19", tag: "found", cls: "tag-amber", text: "3 of 1,200 queries returned neighbor tenant chunks" },
  { t: "00:23", tag: "judge", cls: "tag-amber", text: "LLM judge disagrees with human label on 14% of rows" },
];
---

<Layout
  title="17th Street Labs | We break AI systems. Then we make them hold."
  description="A founder-led AI engineering and security firm in Denver. We build agentic products, attack them before anyone else can, and prove they work with real evaluations."
>
  <section class="hero">
    <HeroThreads />
    <div class="wrap hero-inner">
      <p class="chip">AI engineering, evals, and security</p>
      <h1 class="statement">
        We find the root cause
        <span class="statement-sub">
          before your users, attackers, and, most importantly, <span class="glow-text">your boss.</span>
        </span>
      </h1>
      <p class="lede">
        We build agentic systems, attack them before anyone else can, and
        prove they hold with evaluations you can put in CI.
      </p>
      <div class="hero-actions">
        <a href="/contact/" data-contact-dialog class="button button-solid">
          Bring us the hard problem
          <Icon name="ArrowRight" size={16} />
        </a>
        <a class="button button-line" href="/services/"><span>What we do</span></a>
      </div>
      <p class="hero-meta">
        <span><Icon name="Check" size={14} /> Founder-led, every engagement</span>
        <span><Icon name="Check" size={14} /> Fixed-fee framing weeks</span>
        <span><Icon name="Check" size={14} /> Open-source research</span>
      </p>

      <div class="console" role="img" aria-label="A simulated red-team run against a checkout agent: findings, fixes, and a passing regression gate.">
        <div class="console-bar">
          <span class="console-dots"><i></i><i></i><i></i></span>
          <span class="path">17sl · redteam / checkout-agent / run #418</span>
          <span class="live">live</span>
        </div>
        <div class="console-body">
          <div class="console-log" aria-hidden="true">
            {log.map(({ t, tag, cls, text }) => (
              <div class="row">
                <span class="t">{t}</span>
                <span class:list={["tag", cls]}>{tag}</span>
                <span class:list={{ fixed: cls === "tag-green" }}>{text}</span>
              </div>
            ))}
            <div class="row">
              <span class="t">00:33</span>
              <span class="prompt">❯</span>
              <span class="cursor"></span>
            </div>
          </div>
          <div class="console-side" aria-hidden="true">
            <div>
              <div class="label">Findings</div>
              <div class="big">4 <small>2 critical · 1 high · 1 medium</small></div>
            </div>
            <div>
              <div class="label">Gate status</div>
              <div class="big" style="color: var(--green)">214/214</div>
            </div>
            <div>
              <div class="label">Attack surface</div>
              <div class="meter">
                <div><span>Injection</span><div class="bar red"><i style="width: 82%"></i></div><b>82%</b></div>
                <div><span>Privilege</span><div class="bar red"><i style="width: 64%"></i></div><b>64%</b></div>
                <div><span>Isolation</span><div class="bar"><i style="width: 31%"></i></div><b>31%</b></div>
                <div><span>Judge drift</span><div class="bar"><i style="width: 14%"></i></div><b>14%</b></div>
                <div><span>After fixes</span><div class="bar green"><i style="width: 3%"></i></div><b>3%</b></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="ticker" aria-label={`Failure modes we keep finding: ${findings.join(", ")}`}>
    <span class="ticker-track" aria-hidden="true">
      {[0, 1].map(() => (
        <>
          <span class="ticker-head">failure modes we keep finding</span>
          {findings.map((item) => (
            <span>{item}</span>
          ))}
        </>
      ))}
    </span>
  </div>

  <section class="band">
    <div class="wrap">
      <dl class="proof">
        {proof.map(({ value, label }) => (
          <div>
            <dt>{value}</dt>
            <dd>{label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head">
        <p class="chip">What we do</p>
        <h2 class="section-title">Four ways in. One team on all of them.</h2>
        <p>
          Most engagements start with one and grow into another once the first
          result lands.
        </p>
      </div>
      <ul class="grid-4">
        {services.map((service) => (
          <li>
            <a href={`/services/#${service.slug}`} class="card">
              <span class="card-icon"><Icon name={icons[service.slug]} /></span>
              <h3>{service.title}</h3>
              <p>{service.summary}</p>
              <span class="outcome">{service.outcome}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap research">
      <div>
        <p class="chip">Open-source research</p>
        <h2 class="section-title">Work you can inspect before you hire us.</h2>
        <p class="lede">
          <strong>ExploitHunter</strong> is an open-source, local-first lab for
          studying how AI models discover, validate, and report security
          findings across long-running attack workflows. It is also the
          evaluation harness we use on client work.
        </p>
        <ul class="marks">
          <li>Deterministic and LLM judges scored side by side</li>
          <li>Trajectory, evidence, cost, and tool telemetry on every run</li>
          <li>Reproducible regression gates you can put in CI</li>
        </ul>
        <a class="text-link" href="https://exploithunter.app" target="_blank" rel="noreferrer">
          Explore ExploitHunter <Icon name="ArrowUpRight" size={16} />
        </a>
      </div>
      <div class="panel">
        <div class="panel-head">
          <span><strong>ExploitHunter</strong> · judge comparison</span>
          <span class="mono">173 profiles</span>
        </div>
        <div class="panel-body">
          <dl class="stats">
            <div><dt>412M+</dt><dd>tokens evaluated</dd></div>
            <div><dt>173</dt><dd>model profiles compared</dd></div>
            <div><dt>4,835</dt><dd>scored evaluation rows</dd></div>
          </dl>
          <div class="judges" aria-hidden="true">
            <div><span>Deterministic</span><div class="bar green"><i style="width: 96%"></i></div><b>0.96</b></div>
            <div><span>LLM judge · A</span><div class="bar"><i style="width: 88%"></i></div><b>0.88</b></div>
            <div><span>LLM judge · B</span><div class="bar"><i style="width: 79%"></i></div><b>0.79</b></div>
            <div><span>Human agreement</span><div class="bar"><i style="width: 91%"></i></div><b>0.91</b></div>
            <div><span>Cost per finding</span><div class="bar red"><i style="width: 22%"></i></div><b>$0.14</b></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head">
        <p class="chip">Process</p>
        <h2 class="section-title">How an engagement starts</h2>
        <p>Three steps, in this order. No discovery theater.</p>
      </div>
      <ol class="steps">
        <li>
          <span class="num">01</span>
          <h3>Frame the question that matters</h3>
          <p>
            We name the decision, failure mode, or capability at stake and
            agree on what success looks like before anyone writes code.
          </p>
          <p class="n">1–2 weeks · fixed fee · written recommendation</p>
        </li>
        <li>
          <span class="num">02</span>
          <h3>Build the smallest credible proof</h3>
          <p>
            Architecture, research, and evaluation move together so evidence
            arrives early enough to change direction cheaply.
          </p>
          <p class="n">working software · measured results · not a deck</p>
        </li>
        <li>
          <span class="num">03</span>
          <h3>Harden what survives, then hand it over</h3>
          <p>
            We pressure-test the system, turn findings into controls, and
            leave your team able to run it without us.
          </p>
          <p class="n">controls · regression gates · your team owns it</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head">
        <p class="chip">Team</p>
        <h2 class="section-title">Who you work with</h2>
        <p>The people you meet are the people who do the work.</p>
      </div>
      <div class="founders">
        <div class="card founder">
          <span class="avatar avatar-portrait avatar-marina">
            <img src={marinaHeadshot.src} alt="Marina Levy" width={800} height={800} loading="lazy" decoding="async" />
          </span>
          <div>
            <h3>Marina Levy</h3>
            <p class="role">Co-founder, chief executive</p>
            <p class="bio">
              Runs the firm and the shape of every engagement: scope, cadence,
              and the measurable outcome we are accountable for. Keeps ambitious
              technical work pointed at what the client actually needs.
            </p>
          </div>
        </div>
        <div class="card founder">
          <span class="avatar avatar-portrait">
            <img src={danHeadshot.src} alt="Dan" width={danHeadshot.width} height={danHeadshot.height} loading="lazy" decoding="async" />
          </span>
          <div>
            <h3>Dan</h3>
            <p class="role">Founding Engineer</p>
          </div>
        </div>
        <div class="card founder">
          <span class="avatar" aria-hidden="true">KC</span>
          <div>
            <h3>Kyle Coberly</h3>
            <p class="role">Head of Research</p>
            <p class="bio">
              Staff software engineer and educator. Built a flight simulation and
              training engine, stood up company-wide testing stacks, and led a
              six-engineer rescue of a delayed enterprise rewrite. Graduate
              faculty at the University of Denver.
            </p>
          </div>
        </div>
      </div>
      <div class="band-actions">
        <a class="text-link founders-note" href="/about/">
          More about the firm <Icon name="ArrowRight" size={16} />
        </a>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="closing">
        <h2 class="statement">Tell us what is at stake.</h2>
        <p>
          Send a few honest sentences. You will hear back from an engineer,
          usually within a business day, with a straight answer about whether we can help.
        </p>
        <div class="hero-actions">
          <a href="/contact/" data-contact-dialog class="button button-solid">
            Start a conversation
            <Icon name="ArrowRight" size={16} />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
