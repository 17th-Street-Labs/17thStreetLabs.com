---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import ProductionReality from "../components/ProductionReality.astro";
import { services } from "../data/services";
const lines: Record<string, string> = {
  evals: "Less “feels better.” More “prove it.”",
  agents: "Twenty agents. No tiny digital circus.",
  products: "Fewer buttons. Tell it what you want.",
  models: "Bigger isn’t always smarter.",
  security: "The attackers are getting agents too.",
};
---

<Layout
  title="17th Street Labs | AI that survives contact with reality."
  description="We build, test, and improve AI products. Evals, agents, model strategy, and security."
>
  <section class="hero brand-hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
      <p class="eyebrow">17th Street Labs · AI engineering</p>
      <h1 class="statement">Send us<br /> the hard one.</h1>
      <p class="lede">We help product and engineering teams build AI that works outside the demo. And fix it when it doesn’t.</p>
      <div class="hero-actions">
        <a href="/contact/" data-contact-dialog class="button button-solid">
          Start a conversation <Icon name="ArrowRight" size={16} />
        </a>
      </div>
      </div>
    <div class="hero-geometry" aria-hidden="true">
      <span class="geo geo-one"></span>
      <span class="geo geo-two"></span>
      <span class="geo geo-three"></span>
      <span class="geo geo-four"></span>
      <span class="geo-person"></span>
    </div>
      <ul class="hero-service-strip">
        {services.map((service) => <li><a href={`/services/#${service.slug}`}>{service.title}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <ProductionReality />
      <ul class="service-grid">
        {services.map((service) => (
          <li>
            <a href={`/services/#${service.slug}`} class="card">
              <h3>{service.title}</h3>
              <p>{lines[service.slug]}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band" id="thinking">
    <div class="wrap">
      <div class="band-head messaging-copy">
        <h2 class="section-title">The work makes the case.</h2>
        <p>Explore the AI tools we’ve built, the research we share, and what industry-leading clients say about working with us.</p>
        <a class="text-link" href="/proof/">See the proof <Icon name="ArrowRight" size={16} /></a>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="closing">
        <h2 class="statement">Got an AI problem that's getting weird?</h2>
        <p>Good. Those are usually the interesting ones.</p>
        <div class="hero-actions">
          <a href="/contact/" data-contact-dialog class="button button-solid">Let's talk <Icon name="ArrowRight" size={16} /></a>
        </div>
      </div>
    </div>
  </section>
</Layout>
