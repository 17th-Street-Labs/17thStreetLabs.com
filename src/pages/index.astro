---
import danHeadshot from "../images/headshots/dan-avatar.png";
import marinaHeadshot from "../images/headshots/Marina-Levy-Headshot.png";
import kyleHeadshot from "../images/headshots/kyle-coberly-headshot.jpg";
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import HeroThreads from "../components/HeroThreads.astro";
import { services, proof, findings } from "../data/services";
const icons: Record<string, string> = {
  evals: "Gauge",
  agents: "Braces",
  products: "Sparkles",
  security: "ShieldCheck",
};
const log = [
  { t: "00:00", tag: "run", cls: "tag-blue", text: "support-agent · 214 scenarios · 3 judges · seed 418" },
  { t: "00:04", tag: "probe", cls: "tag-blue", text: "prompt injection via vendor invoice PDF (tool output)" },
  { t: "00:09", tag: "found", cls: "tag-red", text: "run 10 of 10: agent told customer to press the button it must not press" },
  { t: "00:11", tag: "found", cls: "tag-red", text: "trajectory diverged at step 4 · same prompt, same input, different path" },
  { t: "00:16", tag: "probe", cls: "tag-blue", text: "cross-tenant retrieval · 1,200 synthetic tenants" },
  { t: "00:19", tag: "found", cls: "tag-amber", text: "3 of 1,200 queries returned neighbor tenant chunks · dashboard still green" },
  { t: "00:23", tag: "judge", cls: "tag-amber", text: "LLM judge disagrees with itself on 14% of rows" },
];
---

<Layout
  title="17th Street Labs | Make AI actually work."
  description="AI-native engineering for products that have to work in the real world. We build, evaluate, and improve intelligent products and agentic systems, from evals and model architecture to production reliability and AI security."
>
  <section class="hero">
    <HeroThreads />
    <div class="wrap hero-inner">
      <p class="chip">AI-native engineering</p>
      <h1 class="statement">
        Make AI actually work.
        <span class="statement-sub">
          Not in the demo. Not on the benchmark. <span class="glow-text">In the real world.</span>
        </span>
      </h1>
      <p class="lede">
        We build, evaluate, and improve intelligent products and agentic
        systems, from evals and model architecture to production reliability
        and AI security.
      </p>
      <div class="hero-actions">
        <a href="/contact/" data-contact-dialog class="button button-solid">
          Start a project
          <Icon name="ArrowRight" size={16} />
        </a>
        <a class="button button-line" href="/services/"><span>What we do</span></a>
      </div>
      <p class="hero-meta">
        <span><Icon name="Check" size={14} /> Evals, agents, products, security</span>
        <span><Icon name="Check" size={14} /> The people you meet do the work</span>
        <span><Icon name="Check" size={14} /> Open-source research</span>
      </p>

      <div class="console" role="img" aria-label="A simulated evaluation run against a support agent: nine passes, one failure, and what the dashboard missed.">
        <div class="console-bar">
          <span class="console-dots"><i></i><i></i><i></i></span>
          <span class="path">17sl · evals / support-agent / run #418</span>
          <span class="live">live</span>
        </div>
        <div class="console-body">
          <div class="console-log" aria-hidden="true">
            {log.map(({ t, tag, cls, text }) => (
              <div class="row">
                <span class="t">{t}</span>
                <span class:list={["tag", cls]}>{tag}</span>
                <span class:list={{ fixed: cls === "tag-green" }}>{text}</span>
              </div>
            ))}
            <div class="row">
              <span class="t">00:33</span>
              <span class="prompt">❯</span>
              <span class="cursor"></span>
            </div>
          </div>
          <div class="console-side" aria-hidden="true">
            <div>
              <div class="label">Pass rate</div>
              <div class="big">90% <small>the dashboard is green</small></div>
            </div>
            <div>
              <div class="label">The other 10%</div>
              <div class="big" style="color: var(--red)">21 <small>2 critical · 6 high</small></div>
            </div>
            <div>
              <div class="label">Failure modes</div>
              <div class="meter">
                <div><span>Wrong tool</span><div class="bar red"><i style="width: 82%"></i></div><b>82%</b></div>
                <div><span>Invented fact</span><div class="bar red"><i style="width: 64%"></i></div><b>64%</b></div>
                <div><span>Path drift</span><div class="bar"><i style="width: 31%"></i></div><b>31%</b></div>
                <div><span>Judge variance</span><div class="bar"><i style="width: 14%"></i></div><b>14%</b></div>
                <div><span>After fix, re-run</span><div class="bar green"><i style="width: 3%"></i></div><b>3%</b></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="ticker" aria-label={`Failure modes we keep finding: ${findings.join(", ")}`}>
    <span class="ticker-track" aria-hidden="true">
      {[0, 1].map(() => (
        <>
          <span class="ticker-head">production is where AI gets weird</span>
          {findings.map((item) => (
            <span>{item}</span>
          ))}
        </>
      ))}
    </span>
  </div>

  <section class="band">
    <div class="wrap">
      <div class="band-head">
        <p class="chip">The sharpest truth we know</p>
        <h2 class="section-title">10% fail = 90% pass. And 90% pass can still be a disaster.</h2>
        <p>
          Your AI does the right thing nine times. On the tenth it gives the
          wrong answer, calls the wrong tool, invents a fact, misses a
          vulnerability, or tells the customer to press the button they
          absolutely should not press. A support agent that gives harmful
          advice one time in ten is not “90% accurate.” It has a failure
          problem. That is the difference between an impressive prototype and
          a system you can trust with real work.
        </p>
        <p><strong>We engineer for the tenth time.</strong></p>
      </div>
      <dl class="proof">
        {proof.map(({ value, label }) => (
          <div>
            <dt>{value}</dt>
            <dd>{label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head">
        <p class="chip">Production AI</p>
        <h2 class="section-title">AI gets weird when it leaves the prototype.</h2>
        <p>
          The agent that worked beautifully yesterday suddenly takes a
          completely different path. Your “improved” prompt fixes one problem
          and creates three new ones. Your eval says everything is fine. Your
          users disagree. And somehow you are spending HOW much on tokens?
        </p>
        <p>Welcome to production AI. <strong>This is where we work.</strong></p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head">
        <p class="chip">What we do</p>
        <h2 class="section-title">The engineering layer around modern AI.</h2>
        <p>
          You already know how to call an LLM. The hard part is everything
          around the call. That is the work.
        </p>
      </div>
      <ul class="grid-4">
        {services.map((service) => (
          <li>
            <a href={`/services/#${service.slug}`} class="card">
              <span class="card-icon"><Icon name={icons[service.slug]} /></span>
              <h3>{service.title}</h3>
              <p>{service.summary}</p>
              <span class="outcome">{service.outcome}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head">
        <p class="chip">Evals</p>
        <h2 class="section-title">Stop guessing. Start measuring.</h2>
        <p>
          A system can look smarter without becoming more reliable. A prompt
          change can fix one behavior and quietly break another. A judge can
          disagree with itself. A workflow can succeed nine times and
          spectacularly fail on number ten. “Seems better” is not an
          engineering methodology.
        </p>
        <p>So we test the behavior that matters. Then we change something. Then we test it again.</p>
      </div>
      <div class="principles">
        <div class="card">
          <span class="card-icon"><Icon name="Gauge" /></span>
          <h3>Measure behavior, not vibes</h3>
          <p>
            Behavioral evals, trajectory evals, regression suites, adversarial
            scenarios, model comparisons, and baseline comparison. Evals that
            grade the product, not the demo.
          </p>
        </div>
        <div class="card">
          <span class="card-icon"><Icon name="Compass" /></span>
          <h3>Test the judge too</h3>
          <p>
            LLM judges vary. Models vary. Trajectories vary. We measure judge
            reliability against deterministic checks and human labels, so the
            score means something.
          </p>
        </div>
        <div class="card">
          <span class="card-icon"><Icon name="Zap" /></span>
          <h3>Prove the fix worked</h3>
          <p>
            Production feedback loops and regression gates you can put in CI.
            Know when your AI gets better. Know when it gets worse. Know why.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head">
        <p class="chip">Agents</p>
        <h2 class="section-title">Agents can do more than chat.</h2>
        <p>
          They can research, use tools, write code, inspect results, delegate
          work, operate software, run tasks in parallel, and keep trying. The
          engineering challenge is not simply making an agent capable. It is
          making the entire system coherent.
        </p>
      </div>
      <ol class="steps">
        <li>
          <span class="num">01</span>
          <h3>What does it know, see, and touch?</h3>
          <p>
            Context architecture, tool design, and boundaries. Give an agent
            tools. Then give it boundaries. Give it the wrong architecture and
            you have invented an extremely expensive intern with root access.
          </p>
          <p class="n">context · tools · memory · sandboxes</p>
        </li>
        <li>
          <span class="num">02</span>
          <h3>When does it delegate, parallelize, and recover?</h3>
          <p>
            Subagents, orchestration, retries, and the right harness for the
            right model. One agent is interesting. Fifty is architecture.
          </p>
          <p class="n">orchestration · parallelism · harness design</p>
        </li>
        <li>
          <span class="num">03</span>
          <h3>How do we know it succeeded?</h3>
          <p>
            The agent completed the task. Allegedly. We build the evaluation
            around the trajectory, not just the final output, so completion is
            something you can verify rather than something the agent claims.
          </p>
          <p class="n">trajectory evals · observability · proof</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="band">
    <div class="wrap research">
      <div>
        <p class="chip">AI-native products</p>
        <h2 class="section-title">The future of software has fewer buttons.</h2>
        <p class="lede">
          For decades, humans learned how computers wanted to work. Menus,
          forms, tabs, settings, filters, buttons that reveal more buttons. AI
          reverses that relationship. Tell the software what you want. Show it
          something. Give it tools and memory. Let it adapt.
        </p>
        <p>
          The question is not “Where can we add AI?” The question is
          <strong>“What would we build if intelligence had been available from day one?”</strong>
          That is AI-native product design, and it will not look like old
          software with a chatbot attached.
        </p>
      </div>
      <div class="panel">
        <div class="panel-head">
          <span><strong>Model strategy</strong> · bigger is not automatically smarter</span>
          <span class="mono">per task</span>
        </div>
        <div class="panel-body">
          <p>
            The industry has an expensive habit: throw the biggest model at it.
            Sometimes that is right. Sometimes a small local model is better
            for one part of the system, and a hundred cheap agents in parallel
            beat one expensive one. Every tool call, retry, loop, and long
            context is a unit of cost. We measure and pick the system, not a
            favorite model.
          </p>
          <ul class="marks">
            <li>Capability, cost, latency, and throughput, measured per task</li>
            <li>Frontier, specialized, and local models compared on your work</li>
            <li>Privacy as architecture: sometimes the smartest AI never leaves the machine</li>
          </ul>
          <p><strong>The model is a component. The system is the product.</strong></p>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap research">
      <div>
        <p class="chip">AI security</p>
        <h2 class="section-title">The attackers have agents too.</h2>
        <p class="lede">
          Cheap intelligence changes the economics of cyberattacks. An agent
          does not get bored. It does not stop because the first theory
          failed. It generates another hypothesis, tries another path, runs
          another test, then does it hundreds of times in parallel.
        </p>
        <p>
          That changes what offense looks like. It also changes what defense
          has to become. We research automated vulnerability discovery,
          AI-assisted exploit research, adversarial testing, local security
          models, and proactive defense.
        </p>
        <p><strong>The attackers are becoming agentic. Defense has to become agentic too.</strong></p>
      </div>
      <div class="panel">
        <div class="panel-head">
          <span><strong>ExploitHunter</strong> · open-source research</span>
          <span class="mono">173 profiles</span>
        </div>
        <div class="panel-body">
          <p>
            Our open-source, local-first lab for studying how AI models
            discover, validate, and report security findings across
            long-running attack workflows. It is also the eval harness we use
            on client work. Work you can inspect before you hire us.
          </p>
          <dl class="stats">
            <div><dt>412M+</dt><dd>tokens evaluated</dd></div>
            <div><dt>173</dt><dd>model profiles compared</dd></div>
            <div><dt>4,835</dt><dd>scored evaluation rows</dd></div>
          </dl>
          <div class="judges" aria-hidden="true">
            <div><span>Deterministic</span><div class="bar green"><i style="width: 96%"></i></div><b>0.96</b></div>
            <div><span>LLM judge · A</span><div class="bar"><i style="width: 88%"></i></div><b>0.88</b></div>
            <div><span>LLM judge · B</span><div class="bar"><i style="width: 79%"></i></div><b>0.79</b></div>
            <div><span>Human agreement</span><div class="bar"><i style="width: 91%"></i></div><b>0.91</b></div>
            <div><span>Cost per finding</span><div class="bar red"><i style="width: 22%"></i></div><b>$0.14</b></div>
          </div>
          <a class="text-link" href="https://exploithunter.app" target="_blank" rel="noreferrer">
            Explore ExploitHunter <Icon name="ArrowUpRight" size={16} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head">
        <p class="chip">Research mentality</p>
        <h2 class="section-title">We experiment on ourselves first.</h2>
        <p>
          We build our own systems, run our own experiments, benchmark models,
          develop eval techniques, test architectures, spend money discovering
          what does not work, and find surprisingly cheap things that do. Then
          we turn what survives into engineering we can use for clients.
        </p>
        <p>
          Our recommendations do not come from a slide deck about what AI
          might someday do. They come from building it, breaking it, measuring
          it, and building it again.
        </p>
      </div>
      <div class="founders">
        <div class="card founder">
          <span class="avatar avatar-portrait avatar-marina">
            <img src={marinaHeadshot.src} alt="Marina Levy" width={800} height={800} loading="lazy" decoding="async" />
          </span>
          <div>
            <h3>Marina Levy</h3>
            <p class="role">Co-founder, chief executive</p>
            <p class="bio">
              Runs the studio and the shape of every engagement: scope, cadence,
              and the measurable outcome we are accountable for. Keeps ambitious
              technical work pointed at what the client actually needs.
            </p>
          </div>
        </div>
        <div class="card founder">
          <span class="avatar avatar-portrait">
            <img src={danHeadshot.src} alt="Dan" width={danHeadshot.width} height={danHeadshot.height} loading="lazy" decoding="async" />
          </span>
          <div>
            <h3>Dan</h3>
            <p class="role">Founding Engineer</p>
            <p class="bio">
              Asks the annoying questions. What actually happens if we test it?
              What is the cheapest model that can do the job? Are we evaluating
              outputs or the whole trajectory? Where does it break?
            </p>
          </div>
        </div>
        <div class="card founder">
          <span class="avatar avatar-portrait">
            <img src={kyleHeadshot.src} alt="Kyle" width={kyleHeadshot.width} height={kyleHeadshot.height} loading="lazy" decoding="async" />
          </span>
          <div>
            <h3>Kyle Coberly</h3>
            <p class="role">Head of Research</p>
            <p class="bio">
              Staff software engineer and educator. Built a flight simulation and
              training engine, stood up company-wide testing stacks, and led a
              six-engineer rescue of a delayed enterprise rewrite. Graduate
              faculty at the University of Denver.
            </p>
          </div>
        </div>
      </div>
      <div class="band-actions">
        <a class="text-link founders-note" href="/about/">
          More about the studio <Icon name="ArrowRight" size={16} />
        </a>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="closing">
        <h2 class="statement">Send us the hard one.</h2>
        <p>
          The agent that works 90% of the time. The eval nobody trusts. The
          workflow that costs a fortune. The product that needs more than
          another chat window. The security problem that did not exist six
          months ago. That is the work we want.
        </p>
        <div class="hero-actions">
          <a href="/contact/" data-contact-dialog class="button button-solid">
            Start a project
            <Icon name="ArrowRight" size={16} />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
