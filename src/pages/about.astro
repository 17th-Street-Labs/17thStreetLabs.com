---
import danHeadshot from "../images/headshots/dan-avatar.png";
import marinaHeadshot from "../images/headshots/Marina-Levy-Headshot.png";
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { proof } from "../data/services";
---

<Layout
  title="About | 17th Street Labs"
  description="Meet the team and operating principles behind 17th Street Labs, an independent AI engineering and security research firm in Denver."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="chip">About</p>
      <h1 class="statement">Experience without the institution.</h1>
      <p class="lede">
        17th Street Labs is a founder-led AI engineering and security research
        firm. Small by design, direct by default, and built for work where
        judgment matters more than headcount.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <dl class="proof">
        {proof.map(({ value, label }) => (
          <div>
            <dt>{value}</dt>
            <dd>{label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head">
        <p class="chip">Team</p>
        <h2 class="section-title">Senior people, one firm.</h2>
        <p>The people you meet are the people who do the work.</p>
      </div>
      <div class="founders">
        <article class="card founder">
          <span class="avatar avatar-portrait avatar-marina">
            <img src={marinaHeadshot.src} alt="Marina Levy" width={800} height={800} loading="lazy" decoding="async" />
          </span>
          <div>
            <h3>Marina Levy</h3>
            <p class="role">Co-founder, chief executive officer</p>
            <p class="bio">
              Marina sets the operating direction for 17th Street Labs. She
              shapes ambitious technical work into focused engagements with a
              clear scope, a steady cadence, and an outcome we can be held to. If
              an engagement is going well, that is usually her doing.
            </p>
          </div>
        </article>
        <article class="card founder">
          <span class="avatar avatar-portrait">
            <img src={danHeadshot.src} alt="Dan" width={danHeadshot.width} height={danHeadshot.height} loading="lazy" decoding="async" />
          </span>
          <div>
            <h3>Dan</h3>
            <p class="role">Founding Engineer</p>
          </div>
        </article>
        <article class="card founder">
          <span class="avatar" aria-hidden="true">KC</span>
          <div>
            <h3>Kyle Coberly</h3>
            <p class="role">Head of Research</p>
            <p class="bio">
              Software, product, and systems engineer with a parallel career as
              an educator. At Urban Sky he designed and shipped the flight
              simulation and training engine, stood up the company-wide testing
              stack, and built the tooling that lets AI agents work in parallel
              across every company app. At Sunrun he led a six-engineer squad
              through a rescue rewrite of the sales-pipeline tool. Adjunct
              professor at the University of Denver and a seven-time Pluralsight
              Elite Instructor.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head">
        <p class="chip">Principles</p>
        <h2 class="section-title">How we think</h2>
        <p>Three convictions that show up in every piece of work.</p>
      </div>
      <div class="principles">
        <div class="card">
          <span class="card-icon"><Icon name="Gauge" /></span>
          <h3>Evidence over theater</h3>
          <p>
            A fluent demo is not a reliable system. We design measurement that
            survives scrutiny from your engineers, your customers, and your
            auditors.
          </p>
        </div>
        <div class="card">
          <span class="card-icon"><Icon name="ShieldCheck" /></span>
          <h3>Security is architecture</h3>
          <p>
            Permissions, boundaries, data flows, and failure recovery belong in
            the design. Bolting them on at launch is how agents end up in the
            news.
          </p>
        </div>
        <div class="card">
          <span class="card-icon"><Icon name="Zap" /></span>
          <h3>Capability has to transfer</h3>
          <p>
            The engagement pays off when your team leaves with sharper systems
            and stronger judgment, and does not need us for the next change.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="closing">
        <h2 class="statement">Work with us.</h2>
        <p>Send the problem, not a pitch. We will tell you if we can help.</p>
        <div class="hero-actions">
          <a class="button button-solid" href="/contact/">
            Start a conversation
            <Icon name="ArrowRight" size={16} />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
