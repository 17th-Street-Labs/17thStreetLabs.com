---
import "../styles/globals.css";
import Icon from "../components/Icon.astro";
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { name: "Home", href: "/" },
  { name: "Services", href: "/services/" },
  { name: "About", href: "/about/" },
  { name: "Contact", href: "/contact/" },
];
const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://17thstreetlabs.com",
);
const isCurrent = (href: string) =>
  currentPath === (href.replace(/\/$/, "") || "/");
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      document.documentElement.dataset.js = "true";
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f3f4f1" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/" aria-label="17th Street Labs home">
          <span class="brand-mark" aria-hidden="true">17</span>
          <span class="brand-name">17th Street Labs</span>
        </a>
        <nav id="primary-navigation" aria-label="Primary navigation">
          {links.map(({ name, href }) => (
            <a
              href={href}
              class:list={{ active: isCurrent(href) }}
              aria-current={isCurrent(href) ? "page" : undefined}
            >
              {name}
            </a>
          ))}
        </nav>
        <a href="/contact/" class="button button-primary header-cta" data-contact-dialog>
          Start a conversation
        </a>
        <button
          class="menu-button"
          aria-label="Toggle navigation"
          aria-expanded="false"
          aria-controls="primary-navigation"
        >
          <span class="menu-open-icon"><Icon name="Menu" /></span>
          <span class="menu-close-icon" hidden><Icon name="X" /></span>
        </button>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true">17</span>
            <span class="brand-name">17th Street Labs</span>
          </a>
          <p>
            An independent AI engineering and security firm in Denver, working
            with teams anywhere.
          </p>
        </div>
        <nav class="footer-nav" aria-label="Footer navigation">
          {links.map(({ name, href }) => (
            <a href={href}>{name}</a>
          ))}
        </nav>
        <div class="footer-contact">
          <a href="mailto:dan@danlevy.net">dan@danlevy.net</a>
          <a href="https://exploithunter.app" target="_blank" rel="noreferrer">
            ExploitHunter, our open-source research
          </a>
        </div>
        <p class="footer-legal">© 2026 17th Street Labs LLC</p>
      </div>
    </footer>
    <dialog
      class="contact-dialog"
      aria-labelledby="dialog-title"
      aria-describedby="dialog-description"
    >
      <button class="dialog-close" aria-label="Close conversation form">
        <Icon name="X" size={20} />
      </button>
      <h2 id="dialog-title" data-slot="dialog-title">
        What hard problem are you carrying?
      </h2>
      <p id="dialog-description" data-slot="dialog-description">
        A few honest sentences are enough: what you are building, what is
        uncertain, and what happens if it fails. Dan reads every message.
      </p>
      <form
        data-project-brief
        action="mailto:dan@danlevy.net?subject=17th%20Street%20Labs%20%E2%80%94%20project%20brief"
        method="post"
        enctype="text/plain"
      >
        <div class="form-row">
          <label>
            Name
            <input name="name" required autocomplete="name" />
          </label>
          <label>
            Work email
            <input name="email" required type="email" autocomplete="email" />
          </label>
        </div>
        <label>
          Focus
          <select name="focus">
            <option value="" disabled selected>Choose the closest fit</option>
            <option>AI product engineering</option>
            <option>AI security</option>
            <option>Evals &amp; reliability</option>
            <option>Technical advisory</option>
          </select>
        </label>
        <label>
          Context
          <textarea name="context" required rows={5}></textarea>
        </label>
        <button type="submit" class="button button-primary">
          Open project brief
        </button>
        <small>Opens your email app with a draft you can edit before sending.</small>
      </form>
    </dialog>
    <script>
      const menu = document.querySelector<HTMLButtonElement>(".menu-button");
      const nav = document.querySelector<HTMLElement>("#primary-navigation");
      const setMenu = (open: boolean) => {
        menu?.setAttribute("aria-expanded", String(open));
        nav?.classList.toggle("open", open);
        document
          .querySelector<HTMLElement>(".menu-open-icon")
          ?.toggleAttribute("hidden", open);
        document
          .querySelector<HTMLElement>(".menu-close-icon")
          ?.toggleAttribute("hidden", !open);
      };
      menu?.addEventListener("click", () =>
        setMenu(menu.getAttribute("aria-expanded") !== "true"),
      );
      document.addEventListener("keydown", (event) => {
        if (
          event.key === "Escape" &&
          menu?.getAttribute("aria-expanded") === "true"
        ) {
          setMenu(false);
          menu.focus();
        }
      });
      const dialog =
        document.querySelector<HTMLDialogElement>(".contact-dialog");
      document
        .querySelectorAll<HTMLAnchorElement>("[data-contact-dialog]")
        .forEach((link) =>
          link.addEventListener("click", (event) => {
            if (
              !dialog ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey
            )
              return;
            event.preventDefault();
            dialog.showModal();
          }),
        );
      dialog
        ?.querySelector(".dialog-close")
        ?.addEventListener("click", () => dialog.close());
      dialog?.addEventListener("click", (event) => {
        if (event.target !== dialog) return;
        const rect = dialog.getBoundingClientRect();
        if (
          event.clientX < rect.left ||
          event.clientX > rect.right ||
          event.clientY < rect.top ||
          event.clientY > rect.bottom
        )
          dialog.close();
      });
      document
        .querySelectorAll<HTMLFormElement>("[data-project-brief]")
        .forEach((form) =>
          form.addEventListener("submit", (event) => {
            event.preventDefault();
            const data = new FormData(form);
            const lines = [
              `Name: ${data.get("name") || ""}`,
              `Email: ${data.get("email") || ""}`,
              ...(data.get("focus") ? [`Focus: ${data.get("focus")}`] : []),
              "",
              String(data.get("context") || ""),
            ];
            window.location.href = `mailto:dan@danlevy.net?subject=${encodeURIComponent("17th Street Labs — project brief")}&body=${encodeURIComponent(lines.join("\n"))}`;
          }),
        );
    </script>
  </body>
</html>
