---
import "../styles/globals.css";
import LabSignup from "../components/LabSignup.astro";
import SiteMotion from "../components/SiteMotion.astro";
import Icon from "../components/Icon.astro";
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  editorial?: boolean;
}
const { title, description, noindex = false, editorial = false } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { name: "Home", href: "/" },
  { name: "What We Do", href: "/services/" },
  { name: "Proof", href: "/proof/" },
  { name: "About", href: "/about/" },
  { name: "Blog", href: "/lab/" },
  { name: "Contact", href: "/contact/" },
];
const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://17thstreetlabs.com",
);
const isCurrent = (href: string) =>
  currentPath === (href.replace(/\/$/, "") || "/");
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      document.documentElement.dataset.js = "true";
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#302338" />
  </head>
  <body class:list={{ "editorial-page": editorial }}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/" aria-label="17th Street Labs home">
          <img class="brand-mark" src="/logo.svg" width="40" height="40" alt="" aria-hidden="true" />
          <span class="brand-name">17th Street Labs</span>
        </a>
        <nav id="primary-navigation" aria-label="Primary navigation">
          {links.map(({ name, href }) => (
            <a
              href={href}
              class:list={{ active: isCurrent(href) }}
              aria-current={isCurrent(href) ? "page" : undefined}
            >
              {name}
            </a>
          ))}
        </nav>
        <a href="/contact/" class="button button-solid header-cta" data-contact-dialog>
          Start a project
          <Icon name="ArrowRight" size={16} />
        </a>
        <button
          class="menu-button"
          aria-label="Toggle navigation"
          aria-expanded="false"
          aria-controls="primary-navigation"
        >
          <span class="menu-open-icon"><Icon name="Menu" /></span>
          <span class="menu-close-icon" hidden><Icon name="X" /></span>
        </button>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <a class="brand" href="/">
            <img class="brand-mark" src="/logo.svg" width="40" height="40" alt="" aria-hidden="true" />
            <span class="brand-name">17th Street Labs</span>
          </a>
          <p>
            AI-native engineering for products that have to survive contact
            with reality.
          </p>
        </div>
        <nav class="footer-nav" aria-label="Footer navigation">
          <span class="footer-col-title">Explore</span>
          {links.map(({ name, href }) => (
            <a href={href}>{name}</a>
          ))}
        </nav>
        <nav class="footer-tools" aria-label="Tools we build">
          <span class="footer-col-title">Tools we build</span>
          <a href="https://github.com/justsml/ExploitHunter.app" target="_blank" rel="noreferrer">
            Hunt bugs
          </a>
          <a href="https://docslurp.io/" target="_blank" rel="noreferrer">
            Ingest documents
          </a>
        </nav>
        <div class="footer-reading">
          <div><span class="footer-col-title">Blog</span><p>Our newsletter: the experiments, the surprises, the useful bits.</p></div>
          <button class="newsletter-button" data-newsletter-signup>Send me the good stuff</button>
        </div>
        <p class="footer-legal">
          <span>© 2026 17th Street Labs LLC</span>
          <span>Denver, Colorado · New York City · Boston</span>
        </p>
      </div>
    </footer>
    <LabSignup />
    <SiteMotion />
    <dialog
      class="contact-dialog"
      aria-labelledby="dialog-title"
      aria-describedby="dialog-description"
    >
      <button class="dialog-close" aria-label="Close conversation form">
        <Icon name="X" size={20} />
      </button>
      <h2 id="dialog-title" data-slot="dialog-title">
        Tell us what you are building.
      </h2>
      <p id="dialog-description" data-slot="dialog-description">
        A few sentences is plenty. An engineer reads every message.
      </p>
      <form
        data-project-brief
        action="/api/contact/"
        method="post"
      >
        <label class="honeypot" aria-hidden="true">
          Company
          <input name="company" tabindex="-1" autocomplete="off" />
        </label>
        <div class="form-row">
          <label>
            Name
            <input name="name" required autocomplete="name" />
          </label>
          <label>
            Work email
            <input name="email" required type="email" autocomplete="email" />
          </label>
        </div>
        <label>
          What are you working on?
          <textarea name="context" required rows={4}></textarea>
        </label>
        <button type="submit" class="button button-solid">
          Send message
        </button>
        <p class="form-status" data-form-status role="status" aria-live="polite"></p>
        <small>Goes straight to the team. Reply within a business day.</small>
      </form>
    </dialog>
    <script>
      import "../lib/botid-client";
      const menu = document.querySelector<HTMLButtonElement>(".menu-button");
      const nav = document.querySelector<HTMLElement>("#primary-navigation");
      const setMenu = (open: boolean) => {
        menu?.setAttribute("aria-expanded", String(open));
        nav?.classList.toggle("open", open);
        document
          .querySelector<HTMLElement>(".menu-open-icon")
          ?.toggleAttribute("hidden", open);
        document
          .querySelector<HTMLElement>(".menu-close-icon")
          ?.toggleAttribute("hidden", !open);
      };
      menu?.addEventListener("click", () =>
        setMenu(menu.getAttribute("aria-expanded") !== "true"),
      );
      document.addEventListener("keydown", (event) => {
        if (
          event.key === "Escape" &&
          menu?.getAttribute("aria-expanded") === "true"
        ) {
          setMenu(false);
          menu.focus();
        }
      });
      const dialog =
        document.querySelector<HTMLDialogElement>(".contact-dialog");
      document
        .querySelectorAll<HTMLAnchorElement>('[data-contact-dialog], a[href="/contact/"]')
        .forEach((link) =>
          link.addEventListener("click", (event) => {
            if (
              !dialog ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey
            )
              return;
            event.preventDefault();
            setMenu(false);
            dialog.showModal();
          }),
        );
      const contactUrl = new URL(window.location.href);
      if (contactUrl.searchParams.has("contact") && dialog) {
        dialog.showModal();
        contactUrl.searchParams.delete("contact");
        history.replaceState(history.state, "", contactUrl);
      }
      dialog
        ?.querySelector(".dialog-close")
        ?.addEventListener("click", () => dialog.close());
      dialog?.addEventListener("click", (event) => {
        if (event.target !== dialog) return;
        const rect = dialog.getBoundingClientRect();
        if (
          event.clientX < rect.left ||
          event.clientX > rect.right ||
          event.clientY < rect.top ||
          event.clientY > rect.bottom
        )
          dialog.close();
      });
      document
        .querySelectorAll<HTMLFormElement>("[data-project-brief]")
        .forEach((form) => {
          const status = form.querySelector<HTMLElement>("[data-form-status]");
          const button = form.querySelector<HTMLButtonElement>(
            "button[type=submit]",
          );
          const say = (message: string, state: "" | "ok" | "error") => {
            if (!status) return;
            status.textContent = message;
            status.dataset.state = state;
          };

          form.addEventListener("submit", async (event) => {
            event.preventDefault();
            if (button?.disabled) return;
            const data = new FormData(form);
            if (button) button.disabled = true;
            say("Sending…", "");
            data.set("page", window.location.pathname);
            try {
              const response = await fetch("/api/contact/", {
                method: "POST",
                headers: { "content-type": "application/json" },
                body: JSON.stringify(Object.fromEntries(data)),
              });
              const result = await response
                .json()
                .catch(() => ({ ok: false, error: "" }));
              if (response.ok && result.ok) {
                form.reset();
                say("Received. We will reply within a business day.", "ok");
                return;
              }
              if (response.status === 400 || response.status === 403 || response.status === 429) {
                say(result.error || "Please check the form and try again.", "error");
                return;
              }
              throw new Error(result.error || "send failed");
            } catch {
              say("Could not send right now. Please try again in a moment.", "error");
            } finally {
              if (button) button.disabled = false;
            }
          });
        });
    </script>
  </body>
</html>

<style>
  .footer-reading { grid-column: 1 / -1; border-top: 1px solid #ffffff30; padding-top: 1.75rem; display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; }
  .footer-reading p { margin-top: .6rem; }
  .footer-reading button { border: 1px solid #dcec91; background: transparent; color: #dcec91; padding: .85rem 1.1rem; white-space: nowrap; cursor: pointer; }
  .footer-reading button:is(:hover, :focus-visible) { background: #dcec91; color: #302338; }
  @media(max-width: 40rem) { .footer-reading { flex-direction: column; align-items: flex-start; } }
  :global(body:has(.lab-dialog[open])) { overflow: hidden; }
</style>
