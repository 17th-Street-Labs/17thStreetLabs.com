---
interface Props {
  name: string;
  size?: number;
}
const { name, size = 24 } = Astro.props;
const paths: Record<string, string[]> = {
  ArrowUpRight: ["M7 17 17 7", "M7 7h10v10"],
  ArrowRight: ["M5 12h14", "m12 5 7 7-7 7"],
  Menu: ["M4 6h16", "M4 12h16", "M4 18h16"],
  X: ["m6 6 12 12", "M6 18 18 6"],
  ChevronDown: ["m6 9 6 6 6-6"],
  ShieldCheck: ["M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11", "m9 12 2 2 4-4"],
  Braces: ["M8 3H6v7l-2 2 2 2v7h2", "M16 3h2v7l2 2-2 2v7h-2"],
  Sparkles: [
    "m12 3 2.7 6.3L21 12l-6.3 2.7L12 21l-2.7-6.3L3 12l6.3-2.7L12 3",
    "M5 3v4",
    "M3 5h4",
  ],
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {(paths[name] ?? []).map((d) => (
    <path d={d} />
  ))}
</svg>
