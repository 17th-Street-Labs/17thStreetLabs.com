---
/* WebGL prism: a white beam enters from the top of the hero and disperses
   into a spectrum as it falls. Pure fragment shader, no dependencies.
   Falls back to the CSS beam when WebGL is unavailable or motion is reduced. */
---

<canvas class="hero-gl" data-prism aria-hidden="true"></canvas>

<script>
  const VERT = `
attribute vec2 p;
void main() { gl_Position = vec4(p, 0.0, 1.0); }`;

  const FRAG = `
precision highp float;
uniform vec2 u_res;
uniform float u_time;
uniform vec2 u_mouse;
uniform float u_dpr;

// --- noise -------------------------------------------------------------
vec3 hash3(vec2 p) {
  vec3 q = vec3(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)), dot(p, vec2(419.2, 371.9)));
  return fract(sin(q) * 43758.5453);
}
float noise(vec2 p) {
  vec2 i = floor(p), f = fract(p);
  vec2 u = f * f * (3.0 - 2.0 * f);
  float a = hash3(i).x, b = hash3(i + vec2(1.0, 0.0)).x;
  float c = hash3(i + vec2(0.0, 1.0)).x, d = hash3(i + vec2(1.0, 1.0)).x;
  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}
float fbm(vec2 p) {
  float v = 0.0, a = 0.5;
  for (int i = 0; i < 4; i++) { v += a * noise(p); p = p * 2.03 + 13.7; a *= 0.5; }
  return v;
}

// --- spectrum: 0..1 -> violet..red, tuned to sit on a dark ground -------
vec3 spectrum(float t) {
  t = clamp(t, 0.0, 1.0);
  vec3 c = 0.5 + 0.5 * cos(6.28318 * (vec3(1.0, 1.0, 1.0) * t + vec3(0.00, 0.33, 0.67)));
  // bias toward the blue/cyan side so the brand blue anchors the palette
  c = mix(c, vec3(0.45, 0.62, 1.0), 0.06);
  c = pow(c, vec3(0.7));
  return c;
}

void main() {
  vec2 uv = gl_FragCoord.xy / u_res;
  float aspect = u_res.x / u_res.y;
  // origin at top-center; y grows downward
  vec2 q = vec2((uv.x - 0.5) * aspect, 1.0 - uv.y);
  q.x += (u_mouse.x - 0.5) * 0.06;          // gentle parallax
  float t = u_time * 0.12;

  // apex glow: the point where light enters
  float apex = exp(-dot(q, q) * 34.0);

  // beam cone: angle from apex, fanning out downward
  float ang = atan(q.x, max(q.y, 0.001));   // -pi/2..pi/2, 0 = straight down
  float spread = 0.46 + 0.06 * sin(t * 0.7);
  float cone = smoothstep(spread, 0.0, abs(ang));

  // dispersion: hue follows the angle across the cone, widens with depth
  float hue = 0.5 + ang / spread * 0.5;
  hue += (fbm(vec2(q.y * 2.5, t * 0.4)) - 0.5) * 0.15;
  vec3 col = spectrum(hue);

  // rays: streaks along the angle, drifting slowly
  float rays = fbm(vec2(ang * 9.0 + t * 0.3, q.y * 1.4 - t * 0.35));
  rays = pow(smoothstep(0.35, 0.95, rays), 1.6);
  float rays2 = fbm(vec2(ang * 22.0 - t * 0.5, q.y * 3.0 + t * 0.2));
  rays2 = pow(smoothstep(0.5, 1.0, rays2), 2.0);

  // depth falloff: the beam is white at the apex and pure color lower down
  float depth = clamp(q.y * 1.35, 0.0, 1.0);
  float fall = exp(-q.y * 3.0);
  vec3 white = vec3(1.0);
  vec3 beam = mix(white, col, smoothstep(0.01, 0.12, depth));
  float I = cone * fall * (0.28 + 0.95 * rays + 0.45 * rays2);

  // soft haze fills the cone so it reads as light, not stripes
  float haze = cone * fall * 0.22 * (0.6 + 0.4 * fbm(q * 3.0 + t));

  vec3 color = vec3(0.0);
  color += beam * I * 0.7;
  color += col * haze;
  color += white * apex * 0.7;
  color += vec3(0.55, 0.66, 1.0) * exp(-dot(q, q) * 5.0) * 0.10; // ambient blue

  // edges: fade at the sides and bottom so the effect sits inside the hero
  float vign = smoothstep(1.15, 0.25, length(vec2(q.x * 0.9, q.y)));
  color *= vign;

  // tone: keep glow additive but never blow to pure white bands
  color = 1.0 - exp(-color * 1.15);

  // dither to kill banding on the dark ground
  float dither = (hash3(gl_FragCoord.xy + u_time).x - 0.5) / 255.0 * 2.0;
  color += dither;

  gl_FragColor = vec4(color, 1.0);
}`;

  function setup(canvas: HTMLCanvasElement) {
    const hero = canvas.closest<HTMLElement>(".hero");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const gl =
      canvas.getContext("webgl", { alpha: false, antialias: false, premultipliedAlpha: false, powerPreference: "low-power" }) ||
      (canvas.getContext("experimental-webgl") as WebGLRenderingContext | null);
    if (!gl || !hero) return;

    const compile = (type: number, src: string) => {
      const sh = gl.createShader(type)!;
      gl.shaderSource(sh, src);
      gl.compileShader(sh);
      if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {
        console.warn(gl.getShaderInfoLog(sh));
        return null;
      }
      return sh;
    };
    const vs = compile(gl.VERTEX_SHADER, VERT);
    const fs = compile(gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) return;
    const prog = gl.createProgram()!;
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, "p");
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const uRes = gl.getUniformLocation(prog, "u_res");
    const uTime = gl.getUniformLocation(prog, "u_time");
    const uMouse = gl.getUniformLocation(prog, "u_mouse");
    const uDpr = gl.getUniformLocation(prog, "u_dpr");

    // Render at reduced resolution: it is a blurred light field, and the
    // browser upscales it for free.
    const SCALE = 0.6;
    let dpr = 1;
    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 1.5) * SCALE;
      const w = Math.max(1, Math.floor(canvas.clientWidth * dpr));
      const h = Math.max(1, Math.floor(canvas.clientHeight * dpr));
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
        gl.viewport(0, 0, w, h);
      }
    };
    resize();
    new ResizeObserver(resize).observe(canvas);

    let mouse = [0.5, 0.3];
    let target = [0.5, 0.3];
    window.addEventListener(
      "pointermove",
      (e) => {
        target = [e.clientX / window.innerWidth, e.clientY / window.innerHeight];
      },
      { passive: true },
    );

    let visible = true;
    new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(canvas);

    let raf = 0;
    const start = performance.now();
    const frame = (now: number) => {
      raf = 0;
      if (document.hidden || !visible) return;
      mouse[0] += (target[0] - mouse[0]) * 0.04;
      mouse[1] += (target[1] - mouse[1]) * 0.04;
      gl.uniform2f(uRes, canvas.width, canvas.height);
      gl.uniform1f(uTime, reduce.matches ? 0 : (now - start) / 1000);
      gl.uniform2f(uMouse, mouse[0], mouse[1]);
      gl.uniform1f(uDpr, dpr);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      if (!reduce.matches) raf = requestAnimationFrame(frame);
    };
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(frame);
    };
    document.addEventListener("visibilitychange", kick);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) kick();
    }).observe(canvas);
    reduce.addEventListener("change", kick);

    hero.classList.add("has-gl");
    kick();
  }

  document.querySelectorAll<HTMLCanvasElement>("[data-prism]").forEach(setup);
</script>
