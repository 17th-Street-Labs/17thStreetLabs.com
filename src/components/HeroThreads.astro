---
import WebThreads from "./WebThreads";
---

<div class="hero-gl" aria-hidden="true">
  <WebThreads
    client:only="react"
    color1="#06B6D4"
    color2="#F43F5E"
    color3="#FFFFFF"
    speed={0.05}
    threadCount={6}
    frequency={5}
    spread={0.18}
    taper={1}
    position={0.71}
    fanMode="center"
    glow={0.02}
    falloff={0.6}
    thickness={1.1}
    brightness={0.6}
    opacity={0.2}
    mirror
    shimmer={false}
    grain
    grainIntensity={0.05}
    mouseInteraction
    mouseStrength={0.3}
  />
</div>

<script>
  document.querySelectorAll<HTMLElement>(".hero-gl").forEach((el) => {
    el.closest<HTMLElement>(".hero")?.classList.add("has-gl");
  });
</script>
