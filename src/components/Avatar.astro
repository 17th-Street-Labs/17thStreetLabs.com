---
// Founder headshot. Rendered at 6rem (96px), but the Marina crop is scaled
// 1.9x inside its circle, so it needs proportionally more source pixels.
// Everything is emitted as WebP at 1x/2x/3x rather than the multi-hundred-KB
// source PNGs, which were being served ~40x oversized.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Extra CSS zoom applied to the image by `.avatar-marina` and friends. */
  zoom?: number;
  class?: string;
  /** The homepage founder row sits far below the fold on every viewport. */
  loading?: "lazy" | "eager";
}

const { src, alt, zoom = 1, class: className = "", loading = "lazy" } = Astro.props;
const base = Math.round(96 * zoom);
---

<span class:list={["avatar", "avatar-portrait", className]}>
  <Image
    src={src}
    alt={alt}
    width={base}
    height={base}
    densities={[1, 2, 3]}
    format="webp"
    quality={72}
    loading={loading}
    decoding="async"
  />
</span>
